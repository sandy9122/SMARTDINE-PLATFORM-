# SMARTDINE Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_dine
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/smart_dine

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (S3-compatible)
STORAGE_BUCKET=smart-dine-media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123

# Payment Provider
PAYMENT_PROVIDER_KEY=your-payment-key
PAYMENT_PROVIDER_SECRET=your-payment-secret

# AI
AI_API_KEY=your-ai-api-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development